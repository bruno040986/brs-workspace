{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx next build *)",
      "Bash(npx eslint *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git push:*)",
      "Bash(git log *)",
      "mcp__claude-flow__*"
    ],
    "deny": [
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Read(./.env*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
